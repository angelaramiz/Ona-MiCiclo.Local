<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet required ONLY for Firebase Auth sign-in — no data transmission -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Permiso requerido para poder instalar APKs descargadas desde la app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Permiso de cámara para escaneo local OCR de tiras de ovulación -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- La cámara es opcional (solo OCR): no filtrar en Play por hardware -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Permisos para notificaciones -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- EXPLICITLY REMOVE tracking/analytics permissions if any library tries to add them -->
    <uses-permission android:name="android.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".OnaApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnaMiCiclo"
        tools:targetApi="34">

        <!-- WorkManager con Hilt: eliminar el inicializador por defecto para que
             WorkManager use la Configuration.Provider de OnaApp (HiltWorkerFactory).
             Sin esto, el @HiltWorker SyncWorker no podría construirse. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Provider para compartir de forma segura el archivo APK descargado con el instalador de Android -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OnaMiCiclo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad para el escaneo OCR local de las tiras de ovulación -->
        <activity
            android:name=".ocr.presentation.OcrCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OnaMiCiclo" />

        <!-- Widget de pantalla principal (A3): resumen del ciclo -->
        <receiver
            android:name=".core.widget.OnaWidgetProvider"
            android:exported="false"
            android:label="Ona Mi Ciclo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ona_widget_info" />
        </receiver>

    </application>

</manifest>
